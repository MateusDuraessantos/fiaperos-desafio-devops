{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "estufaId",
    "tipo",
    "valorAtual",
    "unidade",
    "dataLeitura"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "estufaId": {
      "type": "integer",
      "minimum": 1
    },
    "tipo": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "valorAtual": {
      "type": "number"
    },
    "unidade": {
      "type": "string",
      "maxLength": 20
    },
    "dataLeitura": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
